  "query": "SELECT t.id, t.user_id, t.expires_at, t.consumed_at, u.env_id\n           FROM tokens t\n           JOIN users u ON u.id = t.user_id\n           WHERE t.token_hash = $1 AND t.token_kind = 'password_reset'\n           LIMIT 1",
