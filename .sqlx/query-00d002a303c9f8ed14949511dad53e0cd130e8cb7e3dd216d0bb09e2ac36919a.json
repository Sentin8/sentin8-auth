  "query": "SELECT\n               id, env_id, actor_user_id,\n               token_id, correlation_id, action,\n               target_resource_type, target_resource_id, timestamp, schema_version\n           FROM audit_events\n           WHERE env_id = $1\n             AND ($2::text IS NULL OR action = $2)\n           ORDER BY timestamp DESC\n           LIMIT $3 OFFSET $4",
