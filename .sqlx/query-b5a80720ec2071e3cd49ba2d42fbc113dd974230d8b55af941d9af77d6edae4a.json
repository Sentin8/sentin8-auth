  "query": "SELECT\n               id, env_id, client_id, client_name,\n               redirect_uris, grant_types, response_types,\n               token_endpoint_auth_method, scopes, status,\n               created_at, updated_at\n           FROM oauth_clients\n           WHERE env_id = $1\n           ORDER BY created_at DESC\n           LIMIT $2 OFFSET $3",
