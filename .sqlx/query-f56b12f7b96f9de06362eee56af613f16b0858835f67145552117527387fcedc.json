  "query": "SELECT\n               id, actor_user_id, target_user_id, token_id, scope, reason, action,\n               expires_at, created_at\n           FROM actor_events\n           WHERE ($1::uuid IS NULL OR target_user_id = $1)\n             AND ($2::uuid IS NULL OR actor_user_id = $2)\n           ORDER BY created_at DESC\n           LIMIT $3 OFFSET $4",
