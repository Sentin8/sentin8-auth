  "query": "SELECT\n               id, user_id, env_id,\n               token_id, status, expires_at, created_at, updated_at\n           FROM sessions\n           WHERE env_id = $1\n             AND ($2::uuid IS NULL OR user_id = $2)\n           ORDER BY created_at DESC\n           LIMIT $3 OFFSET $4",
